<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" 
             Name="Ebantis V4 Installer" 
             Language="1033" 
             Version="4.0.0" 
             Manufacturer="Ebantis" 
             UpgradeCode="B8B8B8B8-B8B8-B8B8-B8B8-B8B8B8B8B8B8">
        
        <Package InstallerVersion="200" 
                 Compressed="yes" 
                 InstallScope="perMachine"
                 Description="Ebantis V4 Agent Installation"
                 Comments="Installs Ebantis V4 Agent using PowerShell installer script"/>
        
        <!-- MajorUpgrade configuration: AllowSameVersionUpgrades="yes" allows reinstalling same version -->
        <MajorUpgrade 
            DowngradeErrorMessage="A newer version of [ProductName] is already installed."
            AllowSameVersionUpgrades="yes"
            Schedule="afterInstallInitialize" />
        
        <MediaTemplate EmbedCab="yes" />
        
        <!-- Property to store MSI filename (will be set by custom action) -->
        <Property Id="MSI_FILENAME" Secure="yes" />
        
        <!-- Property to track if we should run installer (set to 1 by default) -->
        <Property Id="RUNINSTALLER" Value="1" Secure="yes" />
        
        <!-- Installer executable -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="EbantisV4">
                    <Component Id="InstallerExe" Guid="A1A1A1A1-A1A1-A1A1-A1A1-A1A1A1A1A1A1">
                        <File Id="InstallerExeFile" 
                              Source="target\x86_64-pc-windows-msvc\release\ebantis-msi-installer.exe" 
                              KeyPath="yes"/>
                    </Component>
                    
                    <!-- PowerShell installer script -->
                    <Component Id="InstallerScript" Guid="B2B2B2B2-B2B2-B2B2-B2B2-B2B2B2B2B2B2">
                        <File Id="InstallerScriptFile" 
                              Source="installer.ps1" 
                              KeyPath="yes"/>
                    </Component>
                    
                    <!-- PowerShell uninstaller script -->
                    <Component Id="UninstallerScript" Guid="C3C3C3C3-C3C3-C3C3-C3C3-C3C3C3C3C3C3">
                        <File Id="UninstallerScriptFile" 
                              Source="uninstaller.ps1" 
                              KeyPath="yes"/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>
        
        <!-- Set property to pass OriginalDatabase (MSI filename) to executable -->
        <!-- This should run for both fresh installs and upgrades -->
        <CustomAction Id="SetMsiFilename" 
                      Property="MSI_FILENAME" 
                      Value="[OriginalDatabase]" 
                      Execute="immediate"/>
        
        <!-- Custom action to run installer with MSI filename as argument -->
        <!-- Use "check" return type so it blocks and reports failure to MSI if it fails -->
        <!-- This runs on installation, upgrade, and repair -->
        <CustomAction Id="RunInstaller" 
                      Directory="INSTALLFOLDER" 
                      ExeCommand='"[INSTALLFOLDER]ebantis-msi-installer.exe" "[MSI_FILENAME]"' 
                      Execute="deferred" 
                      Impersonate="no" 
                      Return="check"/>
        
        <!-- Custom action to run uninstaller before files are removed -->
        <!-- Use "check" return type so it blocks and reports failure to MSI if it fails -->
        <!-- Run with uninstall flag -->
        <CustomAction Id="RunUninstaller" 
                      Directory="INSTALLFOLDER" 
                      ExeCommand='"[INSTALLFOLDER]ebantis-msi-installer.exe" "-uninstall"' 
                      Execute="deferred" 
                      Impersonate="no" 
                      Return="check"/>
        
        <InstallExecuteSequence>
            <!-- Set MSI filename for both fresh installs, upgrades, and repairs -->
            <!-- Run in all scenarios except uninstall -->
            <!-- Check if REMOVE property is not set to "ALL" (uninstall scenario) -->
            <!-- Use OR with empty check to handle when REMOVE is not set at all -->
            <Custom Action="SetMsiFilename" After="InstallInitialize">(REMOVE="" OR REMOVE&lt;&gt;"ALL")</Custom>
            
            <!-- Run installer after files are installed -->
            <!-- Condition: Run on install, upgrade, repair, but NOT on uninstall -->
            <!-- Check if REMOVE is empty or not equal to "ALL" to cover all install scenarios -->
            <Custom Action="RunInstaller" After="InstallFiles">(REMOVE="" OR REMOVE&lt;&gt;"ALL")</Custom>
            
            <!-- Run uninstaller before files are removed during uninstallation -->
            <!-- This runs before RemoveFiles action -->
            <Custom Action="RunUninstaller" Before="RemoveFiles">REMOVE="ALL"</Custom>
        </InstallExecuteSequence>
        
        <Feature Id="ProductFeature" Title="Ebantis V4 Installer" Level="1">
            <ComponentRef Id="InstallerExe" />
            <ComponentRef Id="InstallerScript" />
            <ComponentRef Id="UninstallerScript" />
        </Feature>
        
        <UI>
            <UIRef Id="WixUI_Minimal" />
            <!-- Removed UI trigger - custom action runs automatically in execute sequence -->
        </UI>
        
    </Product>
</Wix>

